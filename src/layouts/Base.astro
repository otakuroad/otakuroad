---
import '@/styles/tokens.css'
import '@/styles/global.css'
import type { Locale } from '@/i18n'

interface Props {
  lang: Locale
  title: string
  description?: string
}

const { lang, title, description } = Astro.props
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <!-- Matches the app chrome, so an installed window does not show a white strip above the map. -->
    <meta name="theme-color" content="#1F2328" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Installable on the home screen: Android reads the manifest, iOS still needs its own tags. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="otakuroad" />
    <meta name="generator" content={Astro.generator} />
    <!-- Canonical, hreflang, Open Graph and JSON-LD for the prerendered share pages (PLAN §4.3). -->
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Offline map (PLAN §9 M6): the worker precaches the shell and keeps the Akihabara tiles. -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        })
      }
    </script>
  </body>
</html>
