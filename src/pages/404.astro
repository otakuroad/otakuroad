---
/**
 * Not-found page. Cloudflare Pages serves /404.html with a real 404 status for any path that no
 * longer exists — until this file existed, a shop that had closed and been removed kept answering
 * 200 with the map shell, which search engines read as a live page. There is no locale in the URL
 * of a missing page, so all three languages sit on one page and each links to its own map.
 */
import { LOCALES, t, type Locale } from '@/i18n'
import '@/styles/tokens.css'
import '@/styles/global.css'

const links = LOCALES.map((lang) => ({ lang, href: `/${lang}/`, label: t(lang, 'app.title') }))
const MAP_LINK: Record<Locale, string> = { ko: '한국어 지도로', en: 'Open the map in English', ja: '日本語の地図へ' }
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>페이지를 찾을 수 없습니다 · Page not found · ページが見つかりません — otakuroad</title>
  </head>
  <body>
    <main class="nf">
      <p class="nf-code">404</p>
      <section lang="ko">
        <h1>이 페이지는 없습니다</h1>
        <p>주소가 바뀌었거나, 문을 닫아 지도에서 내린 매장일 수 있습니다. 최신 지도에서 다시 찾아보세요.</p>
      </section>
      <section lang="en">
        <h2>This page does not exist</h2>
        <p>The address may have changed, or the shop has closed and been taken off the map. Look it up on the current map.</p>
      </section>
      <section lang="ja">
        <h2>このページはありません</h2>
        <p>アドレスが変わったか、閉店して地図から外した店舗かもしれません。最新の地図で探し直してください。</p>
      </section>
      <nav class="nf-links" aria-label="otakuroad">
        {links.map((l) => (
          <a href={l.href} lang={l.lang}>{MAP_LINK[l.lang]}</a>
        ))}
      </nav>
    </main>
  </body>
</html>

<style>
  .nf {
    max-width: 480px;
    margin: 0 auto;
    padding: calc(var(--safe-top, 0px) + 56px) 24px 48px;
    color: var(--color-text);
  }
  .nf-code {
    margin: 0 0 12px;
    font-size: 44px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-text-tertiary);
  }
  h1,
  h2 {
    margin: 0 0 6px;
    font-size: 20px;
    font-weight: 700;
  }
  section {
    margin-bottom: 20px;
  }
  section p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .nf-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min, 44px);
    padding: 0 18px;
    border-radius: var(--radius-pill, 999px);
    background: var(--color-text);
    color: var(--color-text-inverse);
    text-decoration: none;
    font-weight: 600;
    font-size: 14.5px;
  }
</style>
