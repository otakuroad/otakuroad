---
/**
 * Bare-domain landing. Astro's i18n `redirectToDefaultLocale` emits a two-second meta refresh, which
 * leaves anyone typing the domain staring at a "Redirecting…" notice, so that option is off in
 * astro.config.mjs and this page renders the redirect itself: an immediate meta refresh for clients
 * without JS, `location.replace` for everyone else (no history entry, so Back does not bounce here),
 * plus the canonical and noindex tags the generated page carried. Keep in sync with astro.config.mjs.
 *
 * With JS the redirect follows the browser language when it is one of ours (a Japanese phone lands
 * on /ja/, an English one on /en/); everything else, and the no-JS fallback, goes to Korean.
 */
import { DEFAULT_LOCALE, LOCALES } from '@/i18n'

const target = `/${DEFAULT_LOCALE}/`
const locales: readonly string[] = LOCALES
const canonical = new URL(target, Astro.site ?? Astro.url).href
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>otakuroad</title>
    <script is:inline define:vars={{ target, locales }}>
      const preferred = (navigator.languages || [navigator.language || ''])
        .map((tag) => tag.slice(0, 2).toLowerCase())
        .find((code) => locales.includes(code))
      location.replace(preferred ? `/${preferred}/` : target)
    </script>
  </head>
  <body>
    <a href={target}>otakuroad</a>
  </body>
</html>
