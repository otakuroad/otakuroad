---
import MapApp from '@/components/MapApp.svelte'
import { LOCALES, t, type Locale } from '@/i18n'
import Base from '@/layouts/Base.astro'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as Locale
const title = `${t(lang, 'app.title')} — ${t(lang, 'app.tagline')}`
---

<Base lang={lang} title={title} description={t(lang, 'app.tagline')}>
  <div class="app-shell">
    <MapApp client:only="svelte" lang={lang} />
  </div>
</Base>
